localtrio-home/
runs/
*.log

# 实验数据集与评测输出（由各章脚本下载 / 生成）
experiments/*/datasets/
experiments/*/eval-results/
experiments/*/eval_results/
experiments/*/eval_result/
experiments/*/eval-results*.json
experiments/*/outputs/
experiments/*/train_results/
experiments/*/analysis_results/
